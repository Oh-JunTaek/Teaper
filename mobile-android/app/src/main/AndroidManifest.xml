<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TeacherWorkspaceApplication"
        android:allowBackup="false"
        android:label="문제 출제 워크스페이스"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeacherWorkspace">
        <!-- GPU 라이브러리가 없는 기기에서도 CPU 모드로 계속 실행한다. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_file_paths" />
        </provider>

        <!-- 사용자가 시작한 대용량 모델 다운로드를 화면 밖에서도 알림과 함께 계속한다. -->
        <service
            android:name=".ai.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".ModelManagerActivity"
            android:exported="false" />

        <activity
            android:name=".ModelSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".TeacherChatActivity"
            android:exported="false" />

        <activity
            android:name=".SourcesActivity"
            android:exported="false" />

        <activity
            android:name=".NotesActivity"
            android:exported="false" />

        <activity
            android:name=".ScheduleActivity"
            android:exported="false" />

        <activity
            android:name=".QuickQuizActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
